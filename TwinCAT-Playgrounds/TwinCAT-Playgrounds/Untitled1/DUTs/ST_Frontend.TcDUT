<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_Frontend" Id="{8999031f-8221-425b-9c4c-6f076d65eb0f}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_Frontend :
STRUCT
	//REACT 
	// read HMI 
	cmd : ST_Cmd; 
	// write HMI 
	state : DINT := 1;
    lockout : BOOL ;
	dateTime : ULINT; 
	role : DINT; 
	firstName : STRING(50); 
	lastName : STRING(50); 
	amount : REAL;
	price : REAL;
	mass : REAL; 
	flowRate : REAL; 
	percentageFill : REAL; 
	nozzle : ARRAY [1..3] OF ST_DispenserNozzle; 
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
